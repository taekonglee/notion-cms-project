# 환경변수 템플릿 파일
# 이 파일을 복사하여 .env.local을 생성하고 실제 값을 입력하세요.
# .env.local은 Git에 포함되지 않습니다 (.gitignore 적용).

# Notion API 설정
# https://www.notion.so/my-integrations 에서 Integration 생성 후 시크릿 키 복사
NOTION_API_KEY=your_notion_integration_api_key

# Notion 데이터베이스 ID
# Notion DB 페이지 URL에서 추출: https://www.notion.so/{workspace}/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your_notion_database_id

# On-Demand ISR 인증 토큰
# POST /api/revalidate 요청 시 Authorization: Bearer <token> 헤더에 사용
# 임의의 강력한 문자열로 설정 (예: openssl rand -hex 32)
REVALIDATE_SECRET=your_revalidate_secret_token
